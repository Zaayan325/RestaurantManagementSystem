@model RestaurantManagementSystem.Models.ViewModels.DashboardViewModel

<div class="container-fluid px-4 mt-4">
    <h2 class="mb-4"><i class="bi bi-house-door"></i> Dashboard</h2>

    <div class="row g-3">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4 border-0 shadow">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-white-50">Available Tables</div>
                        <h3 class="fw-bold">@Model.AvailableTables</h3>
                    </div>
                    <i class="bi bi-grid-3x3-gap fs-1 opacity-50"></i>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small">
                    <a class="text-white stretched-link" asp-controller="Table" asp-action="Index">View Floor Plan</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark mb-4 border-0 shadow">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-dark-50">Kitchen Load</div>
                        <h3 class="fw-bold">@Model.PreparingOrders Preparing</h3>
                    </div>
                    <i class="bi bi-fire fs-1 opacity-50"></i>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small text-dark">
                    <a class="text-dark stretched-link" asp-controller="Order" asp-action="Index">Manage Orders</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4 border-0 shadow">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-white-50">Revenue (Today)</div>
                        <h3 class="fw-bold">@Model.DailyStats.TotalSalesToday.ToString("N0") PKR</h3>
                    </div>
                    <i class="bi bi-currency-dollar fs-1 opacity-50"></i>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small">
                    <a class="text-white stretched-link" asp-controller="Report" asp-action="Index">View Detailed Report</a>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white shadow border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-white-50">Active Menu</div>
                            <h3 class="fw-bold mb-0">@Model.AvailableItems <small class="fs-6">Items</small></h3>
                        </div>
                        <i class="bi bi-journal-text fs-1 opacity-25"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a class="text-white small text-decoration-none" asp-controller="Menu" asp-action="Index">Update Availability →</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-bar-chart-line me-1"></i> Today's Top Selling Items
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Quantity</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DailyStats.TopSellingItems)
                            {
                                <tr>
                                    <td>@item.ItemName</td>
                                    <td>@item.Count</td>
                                    <td>@item.Revenue.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-pie-chart me-1"></i> Orders by Type
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var type in Model.DailyStats.OrdersByServiceType)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @type.Key
                                <span class="badge bg-primary rounded-pill">@type.Value</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>