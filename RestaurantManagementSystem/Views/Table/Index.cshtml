@model IEnumerable<RestaurantManagementSystem.Models.Table>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Restaurant Floor Plan</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add New Table</a>
    }
</div>

<div class="row">
    @foreach (var table in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 @(GetBorderClass(table.Status))">
                <div class="card-body text-center">
                    <h5 class="card-title">@table.TableName</h5>
                    <p class="card-text text-muted">Capacity: @table.Capacity Seats</p>
                    <span class="badge @(GetBadgeClass(table.Status)) mb-3">@table.Status</span>

                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            Change Status
                        </button>
                        <ul class="dropdown-menu">
                            <li><form asp-action="UpdateStatus" asp-route-id="@table.Id" asp-route-status="Available" method="post"><button class="dropdown-item">Available</button></form></li>
                            <li><form asp-action="UpdateStatus" asp-route-id="@table.Id" asp-route-status="Occupied" method="post"><button class="dropdown-item">Occupied</button></form></li>
                            <li><form asp-action="UpdateStatus" asp-route-id="@table.Id" asp-route-status="Reserved" method="post"><button class="dropdown-item">Reserved</button></form></li>
                            <li><form asp-action="UpdateStatus" asp-route-id="@table.Id" asp-route-status="Cleaning" method="post"><button class="dropdown-item">Cleaning</button></form></li>
                        </ul>
                    </div>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="card-footer d-flex justify-content-around">
                        <a asp-action="Edit" asp-route-id="@table.Id" class="btn btn-sm btn-link text-warning">Edit</a>
                    </div>
                }
            </div>
        </div>
    }
</div>

@functions {
    string GetBorderClass(TableStatus status) => status switch
    {
        TableStatus.Available => "border-success",
        TableStatus.Occupied => "border-danger",
        TableStatus.Reserved => "border-primary",
        _ => "border-warning"
    };

    string GetBadgeClass(TableStatus status) => status switch
    {
        TableStatus.Available => "bg-success",
        TableStatus.Occupied => "bg-danger",
        TableStatus.Reserved => "bg-primary",
        _ => "bg-warning text-dark"
    };
}