@model IEnumerable<RestaurantManagementSystem.Models.MenuItem>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Restaurant Menu</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Chef"))
    {
        <a asp-action="Create" class="btn btn-primary">Add New Item</a>
    }
</div>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Category?.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>
                    <form asp-action="ToggleAvailability" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.Id" />

                        @if (item.IsAvailable)
                        {
                            <button type="submit" class="btn btn-sm btn-success w-100">
                                <i class="bi bi-check-circle"></i> Available
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-danger w-100">
                                <i class="bi bi-x-circle"></i> Not Available
                            </button>
                        }
                    </form>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Delete this item?')">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>