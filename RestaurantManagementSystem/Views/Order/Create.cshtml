@model RestaurantManagementSystem.Models.Order

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-cart-plus-fill"></i> New Order</h4>
            <span class="badge bg-secondary">Step 1: Select Items</span>
        </div>
        <div class="card-body">
            <form asp-action="Create" id="orderForm">

                <div class="row g-3 mb-4 p-3 bg-light rounded">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Service Type</label>
                        <select asp-for="ServiceType" class="form-select" id="serviceType"
                                asp-items="Html.GetEnumSelectList<RestaurantManagementSystem.Models.ServiceType>()">
                        </select>
                    </div>
                    <div class="col-md-6" id="tableSelectionDiv">
                        <label class="form-label fw-bold">Assign Table</label>
                        <select asp-for="TableId" class="form-select" asp-items="ViewBag.Tables">
                            <option value="">-- Choose Table --</option>
                        </select>
                        <span asp-validation-for="TableId" class="text-danger"></span>
                    </div>
                </div>

                <h5 class="border-bottom pb-2 mb-3">Order Items</h5>
                <table class="table table-hover" id="itemsTable">
                    <thead class="table-secondary">
                        <tr>
                            <th style="width: 60%;">Menu Item</th>
                            <th style="width: 25%;">Quantity</th>
                            <th style="width: 15%; text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="orderItemsContainer">
                    </tbody>
                </table>

                <button type="button" class="btn btn-outline-primary btn-sm mb-4" onclick="addRow()">
                    <i class="bi bi-plus-circle"></i> Add Another Item
                </button>

                <div class="d-flex justify-content-between border-top pt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                    <button type="submit" class="btn btn-success px-5 shadow">Confirm & Place Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let index = 0;

        // Function to add a new row of items
        function addRow() {
            const container = document.getElementById('orderItemsContainer');
            const row = `
                <tr id="row_${index}">
                    <td>
                        <select name="OrderItems[${index}].MenuItemId" class="form-select" required>
                            <option value="">-- Select Dish --</option>
                            @foreach (var item in ViewBag.MenuItems)
                            {
                                    <option value="@item.Id">@item.Name (@item.Price PKR)</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input name="OrderItems[${index}].Quantity" type="number" class="form-control text-center" value="1" min="1" required />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(${index})">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>`;

            container.insertAdjacentHTML('beforeend', row);
            index++;
        }

        function removeRow(id) {
            const row = document.getElementById(`row_${id}`);
            row.remove();
        }

        // Logic to hide Table selection if it's not Dine-In
        document.getElementById('serviceType').addEventListener('change', function() {
            const tableDiv = document.getElementById('tableSelectionDiv');
            // Value 0 usually corresponds to DineIn in the Enum
            tableDiv.style.display = (this.value == "0") ? "block" : "none";
        });

        // Add the first row automatically on page load
        window.onload = addRow;
    </script>
}